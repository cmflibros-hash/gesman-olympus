RewriteEngine On

# Protect hidden files (credentials, git metadata, etc.)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Canonical URLs without .php extension
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

RewriteCond %{REQUEST_URI} ^/(.+)\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
RewriteRule ^ %1 [R=301,L]

# Keep existing files/directories untouched
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Landing section routes without hash (#)
RewriteRule ^(top|que-es|modulos|beneficios|contacto)/?$ index.php [L,QSA]

# Extensionless route -> PHP file when it exists
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
